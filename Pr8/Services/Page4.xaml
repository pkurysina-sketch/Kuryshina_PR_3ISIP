<Page x:Class="CarConfigurator.Services.Page4"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Шаг 4 из 4" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <ProgressBar Value="4" Maximum="4" Height="10" Margin="0,30,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="Имя (мин. 2 символа):"/>
            <TextBox x:Name="TxtName"  Margin="0,0,0,10" TextChanged="CheckValidation"/>

            <TextBlock Text="Телефон (только цифры):"/>
            <TextBox x:Name="TxtPhone" Margin="0,0,0,10" TextChanged="CheckValidation"/>

            <TextBlock Text="Email (содержит @):"/>
            <TextBox x:Name="TxtEmail" Margin="0,0,0,20" TextChanged="CheckValidation"/>

            <Button x:Name="BtnSubmit" Content="Оформить заявку"
                    IsEnabled="False" Padding="10,5" Click="BtnSubmit_Click"
                    HorizontalAlignment="Left"/>

            <GroupBox Header="Итоговая сводка" Margin="0,20,0,0">
                <TextBlock x:Name="SummaryText" Margin="5" FontWeight="Bold"
                           TextWrapping="Wrap"/>
            </GroupBox>
        </StackPanel>

        <Grid Grid.Row="2">
            <Button Content="Назад" HorizontalAlignment="Left"  Width="100" Padding="5"
                    Click="BtnBack_Click"/>
        </Grid>
    </Grid>
</Page>


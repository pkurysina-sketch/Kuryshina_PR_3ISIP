<Page x:Class="CarConfigurator.Services.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Шаг 2 из 4" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <ProgressBar Value="2" Maximum="4" Height="10" Margin="0,30,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="Итоговая стоимость:" FontSize="18"/>
            <TextBlock x:Name="PriceText" FontSize="30" FontWeight="Bold" Margin="0,5,0,20"/>
            <TextBlock x:Name="DetailsText" FontSize="14" TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Button Content="Назад" HorizontalAlignment="Left"  Width="100" Padding="5"
                    Click="BtnBack_Click"/>
            <Button Content="Далее" HorizontalAlignment="Right" Width="100" Padding="5"
                    Click="BtnNext_Click"/>
        </Grid>
    </Grid>
</Page>


<Page x:Class="CarConfigurator.Services.Page3"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Шаг 3 из 4" FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <ProgressBar Value="3" Maximum="4" Height="10" Margin="0,30,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock x:Name="DownPaymentLabel" FontWeight="Bold"/>
            <Slider x:Name="SliderDownPayment" Minimum="10" Maximum="90"
                    Value="20" TickFrequency="5" IsSnapToTickEnabled="True"
                    ValueChanged="LoanChanged" Margin="0,5,0,20"/>

            <TextBlock x:Name="TermLabel" FontWeight="Bold"/>
            <Slider x:Name="SliderTerm" Minimum="12" Maximum="96"
                    Value="60" TickFrequency="12" IsSnapToTickEnabled="True"
                    ValueChanged="LoanChanged" Margin="0,5,0,20"/>

            <Separator Margin="0,10"/>
            <TextBlock x:Name="LoanResultText" FontSize="16" FontWeight="Bold"
                       Margin="0,10,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Button Content="Назад" HorizontalAlignment="Left"  Width="100" Padding="5"
                    Click="BtnBack_Click"/>
            <Button Content="Далее" HorizontalAlignment="Right" Width="100" Padding="5"
                    Click="BtnNext_Click"/>
        </Grid>
    </Grid>
</Page>


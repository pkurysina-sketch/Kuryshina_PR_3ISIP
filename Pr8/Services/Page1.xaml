<Page x:Class="CarConfigurator.Services.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Шаг 1"
      Background="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="StepText" Text="Шаг 1 из 4"
                       FontSize="20" FontWeight="Bold"
                       HorizontalAlignment="Center"/>
            <ProgressBar x:Name="Progress" Value="1" Maximum="4"
                         Height="10" Margin="0,30,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <TextBlock Text="Модель:" FontWeight="Bold"/>
            <ComboBox x:Name="ComboModel"
                      SelectionChanged="ComboModel_SelectionChanged"
                      Margin="0,5,0,15"/>

            <TextBlock Text="Двигатель:" FontWeight="Bold"/>
            <ComboBox x:Name="ComboEngine" Margin="0,5,0,15"/>

            <TextBlock Text="Цвет:" FontWeight="Bold"/>
            <ComboBox x:Name="ComboColor" Margin="0,5,0,15"/>

            <TextBlock Text="Опции:" FontWeight="Bold" Margin="0,10,0,0"/>
            <CheckBox x:Name="ChkLeather"  Content="Кожаный салон (+80 000)" Margin="0,2"/>
            <CheckBox x:Name="ChkPanorama" Content="Панорама (+60 000)"      Margin="0,2"/>
        </StackPanel>

        <Button Grid.Row="2" Content="Далее"
                HorizontalAlignment="Right" Width="100" Padding="5"
                Click="BtnNext_Click"/>
    </Grid>
</Page>

